# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Contact (Resend)
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify cpwd.nl at https://resend.com/domains (required for noreply@cpwd.nl)
# 3. For local testing only: use onboarding@resend.dev as FROM (sends to your Resend account email)
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=info@cpwd.nl
CONTACT_FROM_EMAIL=CPWD Contact <noreply@cpwd.nl>

# Site
NUXT_PUBLIC_SITE_URL=https://www.cpwd.nl
# Google Search Console → Instellingen → Eigendomsverificatie → HTML-tag
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Website scanner - Google PageSpeed Insights API v5 (server-only, never NUXT_PUBLIC_*)
# https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=
# Optional: SITE_AUDIT_MOCK=1 for local UI without calling Google
